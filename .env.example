# Conexão do app (papel pos_app, sujeito ao RLS)
DATABASE_URL=postgres://pos_app:pos_app_dev@localhost:5432/pos_saas
# Conexão de migrations (papel pos_owner, dono das tabelas)
DATABASE_OWNER_URL=postgres://pos_owner:pos_owner_dev@localhost:5432/pos_saas

# Login (gere um segredo com: npx @better-auth/cli secret)
BETTER_AUTH_SECRET=troque-por-um-segredo-longo
BETTER_AUTH_URL=http://localhost:3000

# Domínio raiz: instituições ficam em <slug>.ROOT_DOMAIN
ROOT_DOMAIN=localhost:3000

# Videoconferência das aulas ao vivo (Daily). Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#DAILY_API_KEY=
#DAILY_WEBHOOK_SECRET=

# Documentos dos alunos. Sem S3_ENDPOINT, grava na pasta local .storage (só desenvolvimento).
# Em produção use o MinIO da VPS (protocolo S3) e crie o bucket antes (privado).
# Segredo que cifra a chave do Asaas de cada instituição (use um valor longo e aleatório)
PAYMENT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Vídeos gravados: se o navegador alcança o MinIO por outro endereço que o servidor, informe-o aqui (padrão: S3_ENDPOINT).
#S3_PUBLIC_ENDPOINT=https://arquivos.seudominio.com.br
#S3_ENDPOINT=http://localhost:9000
#S3_REGION=us-east-1
#S3_BUCKET=pos-saas
#S3_ACCESS_KEY=minio
#S3_SECRET_KEY=minio-dev-secret

# E-mail (Resend). Sem chave, os e-mails só aparecem no console.
# Em produção, o domínio de EMAIL_FROM precisa estar verificado no Resend (registros DNS).
RESEND_API_KEY=
EMAIL_FROM=nao-responda@seudominio.com.br

# Usuário master criado pelo seed (desenvolvimento)
MASTER_EMAIL=master@plataforma.local
MASTER_PASSWORD=trocar-esta-senha
