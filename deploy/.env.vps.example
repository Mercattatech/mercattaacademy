# Copie para deploy/.env.vps (fora do git) e preencha TUDO.
# Segredos fortes: openssl rand -base64 32

# --- Endereço da plataforma ---
# Domínio raiz, sem https:// e sem barra. As instituições ficam em <slug>.DOMINIO
ROOT_DOMAIN=plataforma.com.br
ACME_EMAIL=voce@empresa.com.br

# --- Banco ---
POSTGRES_SUPERUSER_PASSWORD=
POS_OWNER_PASSWORD=
POS_APP_PASSWORD=

# --- Arquivos (MinIO, dentro da própria VPS) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Segredos do app ---
BETTER_AUTH_SECRET=
# GUARDE este valor: sem ele as chaves do Asaas salvas não abrem.
PAYMENT_SECRET=

# --- E-mail (Resend). Sem chave, os e-mails só aparecem no log. ---
RESEND_API_KEY=
EMAIL_FROM=nao-responda@plataforma.com.br

# --- Aulas ao vivo (Daily), opcional ---
DAILY_API_KEY=
DAILY_WEBHOOK_SECRET=
